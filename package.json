{
  "name": "@sorottl/backend",
  "version": "0.1.0",
  "description": "Backend and keeper service for SoroTTL - Stellar Soroban state TTL monitoring and inspection",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sorottl": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "stellar",
    "soroban",
    "ttl",
    "keeper",
    "monitoring",
    "state-archival"
  ],
  "author": "SoroTTL-Network",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sorottl/sdk": "file:../sorottl-sdk",
    "@stellar/stellar-sdk": "^17.4.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
